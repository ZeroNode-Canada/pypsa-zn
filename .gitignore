# ------------------------------------------------------------------------------
# Python artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.dll
*.egg-info/
.eggs/
build/
dist/
# aimmspy's get_model() insists on writing a 3.8 MB stub of the PSO model
# somewhere, and there is no way to decline it. The runner sends it to the OS
# temp directory, so nothing here should produce one any more -- this stays as
# a backstop, because get_model()'s own default drops a hidden ".pyi" into
# whatever directory the process was started from.
*.pyi

# ------------------------------------------------------------------------------
# Virtual environments
# ------------------------------------------------------------------------------
venv/
.env/
.envrc
.pyenv/

# ------------------------------------------------------------------------------
# Jupyter / temp
# ------------------------------------------------------------------------------
.ipynb_checkpoints/
*.log
*.tmp
*.bak

# ------------------------------------------------------------------------------
# OS / editor
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# ------------------------------------------------------------------------------
# DevNet generated outputs (DO NOT COMMIT)
# ------------------------------------------------------------------------------
# Stress outputs
*/stress_out/
*/_preview/

# Logs
logs/
*/logs/

# Plots
plots/
*/plots/

# Exported PyPSA CSV networks (generated)
devnet-sld/
devnet-sld*/
devnetDC-sld/
devnetDC-sld*/

# ercot7k PSO run output (generated -- logs, results; not the case inputs above)
# Every run nests under this ONE parent, because the run name is the operator's
# to choose and a root-level run directory could only be ignored by guessing it.
ercot7k-runs/
# Pre-nesting layout, still ignored so an existing checkout does not suddenly
# show 400 MB per old run.
ercot7k-run/
ercot7k-run*/

# ------------------------------------------------------------------------------
# Local PSO config (machine/site-specific -- DO NOT COMMIT)
# ------------------------------------------------------------------------------
pso.local.toml

# ------------------------------------------------------------------------------
# DevNet config (user-editable — DO NOT COMMIT)
# ------------------------------------------------------------------------------
devnet_config/*.csv

# ------------------------------------------------------------------------------
# ercot7k config (user-editable -- DO NOT COMMIT)
# ------------------------------------------------------------------------------
ercot7k_config/*.csv

# ------------------------------------------------------------------------------
# Large / generated data
# ------------------------------------------------------------------------------
*.xlsx
*.csv
*.json
*.png

# EXCEPT compliance artifacts
!compliance/

# EXCEPT reference artifacts
!devnet-stress-vectors/
!devnet-stress-vectors/**

# EXCEPT the ercot7k PSO case inputs (input tables, not generated)
!ercot7k/
!ercot7k/**

# EXCEPT the case's side-cars (bus coordinates, source manifest) and the
# datacenter injector templates -- inputs, not generated
!ercot7k_geo/
!ercot7k_geo/**
!injector_templates/
!injector_templates/**
# Ignore run output if a run is written into the case dir
ercot7k/logs/
ercot7k/results/
# PSO writes these two into the *input* folder on every run, so !ercot7k/**
# above would otherwise offer them up as new case files:
#   <root>.status            - PSO1.ams copies the runlog beside SelectedDataFile
#   <root>_SCH_TMP<n>X.csv   - TS.ams SchFilterTable leaves the pre-filtered
#                              schedule copy next to its source; the trailing X
#                              is what separates it from the tracked SCH_TMP<n>
ercot7k/*.status
ercot7k/*_SCH_TMP*X.csv
# The study pin (ercot7k_results.py pin --case-dir). It is DERIVED FROM A RUN,
# not a case input: it records which hour every later run reports on. It has to
# live in the BASE case because case_digest() covers it, so writing one into a
# layer that already has children would make walk_chain() reject them as
# hand-edited -- the base is the only place with no digest to invalidate.
ercot7k/study.json

# EXCEPT the test fixtures (mini7k is cut from ercot7k by tests/cut_mini7k.py
# and is checked in so the suite runs without the 4.89 MB case)
!tests/fixtures/
!tests/fixtures/**

# ercot7k derived case layers (generated by ercot7k_case.py -- DO NOT COMMIT)
ercot7k-derived/

# ercot7k sweep output (generated by ercot7k_sweep.py -- DO NOT COMMIT)
# Plans, per-step records, the summary table and the mapped artifacts. Small
# next to the runs they describe, but still generated.
ercot7k-sweeps/

# ------------------------------------------------------------------------------
# Reference outputs (keep controlled artifacts)
# ------------------------------------------------------------------------------
# Keep:
!devnet-stress-vectors/devnet_plots.xlsx
!devnet-stress-vectors/*.md
!devnet-stress-vectors/*.html

# Keep curated reference runs
!devnet-reference-runs/
!devnet-reference-runs/**
# Ignore logs
devnet-reference-runs/*/logs/

# ------------------------------------------------------------------------------
# Security / local paths
# ------------------------------------------------------------------------------
*.key
*.pem
*.env
*.secrets

# ------------------------------------------------------------------------------
# Misc
# ------------------------------------------------------------------------------
*.zip
*.tar
*.gz
